{
 "title": "PharmaGuard AI - Production Monitoring",
 "uid": "pharmaguard-monitoring",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "tags": [
  "pharmaguard",
  "ai"
 ],
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "type": "datasource",
   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Availability",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_availability_ratio",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Request latency (ms)",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_request_latency_ms",
     "legendFormat": "p{{quantile}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Requests by status",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_requests_total",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Answer quality (golden set)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_ai_answer_quality_ratio",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Unsupported claims / guardrail failures",
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_ai_unsupported_claim_ratio or pharmaguard_ai_guardrail_failures",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Retrieval failures",
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_ai_retrieval_failures",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Data quality score & missing ratio",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_data_quality_score or pharmaguard_data_missing_ratio",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Data drift (PSI) by feature",
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_data_drift_psi",
     "legendFormat": "{{feature}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Schema changes",
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_data_schema_changes",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Unauthorized / suspicious",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_security_unauthorized_requests or pharmaguard_security_suspicious_inputs",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "LLM tokens",
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_llm_tokens",
     "legendFormat": "{{direction}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Estimated LLM cost (USD)",
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_llm_estimated_cost_usd",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Investigations assisted / pending reviews",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_investigations_assisted or pharmaguard_pending_reviews",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Human review decisions",
   "gridPos": {
    "x": 8,
    "y": 32,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_human_reviews",
     "legendFormat": "{{decision}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Indicator status (0 ok, 1 warn, 2 critical)",
   "gridPos": {
    "x": 16,
    "y": 32,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "pharmaguard_indicator_status",
     "legendFormat": "{{category}}/{{indicator}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  }
 ]
}