# Copy to .env and adjust. Never commit .env.
RANDOM_SEED=42
N_ROWS=3000
RAW_DATA_PATH=data/raw/pharma_batch_raw.csv
PROCESSED_DATA_DIR=data/processed
LOG_LEVEL=INFO

# Batch Investigation Assistant. No API key = deterministic demo mode (no data leaves the machine).
# LLM_PROVIDER: anthropic | openai (any OpenAI-compatible endpoint) | mock
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional: model id (defaults: claude-sonnet-5 for anthropic, gpt-4o-mini for openai)
LLM_MODEL=
# Optional: endpoint override (proxy / OpenAI-compatible server)
LLM_BASE_URL=
LLM_MAX_TOKENS=900
LLM_TIMEOUT=60

# ---- Runtime paths (optional; defaults are relative to the app directory) --------------------------------
# In Docker, mount volumes at /app/data/app and /app/logs instead of changing these.
# PHARMAGUARD_DB_PATH=/app/data/app/pharmaguard_review.db
# PHARMAGUARD_OBS_DB=/app/data/app/observability.db
# PHARMAGUARD_LOG_DIR=/app/logs

# ---- Streamlit (already set inside the Docker image; override only if needed) ----------------------------
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ---- AI evaluation gate (CI only) ------------------------------------------------------------------------
# Thresholds live in config/evaluation_gate.yaml; override with EVAL_GATE_MODE=warn or EVAL_GATE_<METRIC>_MIN/_MAX.

